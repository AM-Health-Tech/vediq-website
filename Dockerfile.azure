FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN npm run build:azure

FROM node:22-alpine AS server-dependencies
WORKDIR /server
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
COPY --from=builder --chown=node:node /app/out ./public
COPY --from=server-dependencies --chown=node:node /server/node_modules ./node_modules
COPY --chown=node:node server/server.mjs ./server.mjs
USER node
EXPOSE 8080
CMD ["node", "server.mjs"]
